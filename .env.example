# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5100
# Comma-separated allowed browser origins (include Vercel URL in production)
WEB_ORIGIN=http://localhost:5174
# Optional refresh cookie policy override: lax | none | strict (defaults to 'none' in production)
COOKIE_SAME_SITE=

# ── Database (SQLite for local dev; switch to PostgreSQL URL in production) ───
DATABASE_URL="file:./dev.db"
# Production example:
# DATABASE_URL="postgresql://broker:broker_pass@localhost:5432/indian_broker?schema=public"

# ── Cache (optional Redis; falls back to in-memory cache when unset) ──────────
REDIS_URL=

# ── Security & Secrets (NEVER commit real secrets) ────────────────────────────
JWT_SECRET=replace_with_min_32_char_random_secret_for_access_tokens
JWT_REFRESH_SECRET=replace_with_min_32_char_random_secret_for_refresh_tokens
ENCRYPTION_KEY=replace_with_32_byte_hex_encryption_key_for_secrets

# ── Internal Market Data Provider Credentials (Server-Side Only) ──────────────
# Never expose provider identity or credentials to the frontend.
MARKET_DATA_CLIENT_ID=
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
# Optional: 24h access token or TOTP credentials for automated daily refresh
MARKET_DATA_ACCESS_TOKEN=
MARKET_DATA_PIN=
MARKET_DATA_TOTP_SECRET=

# ── Blockchain Verification ───────────────────────────────────────────────────
BLOCKCHAIN_POW_DIFFICULTY=2
EVM_RPC_URL=
EVM_CONTRACT_ADDRESS=

# ── AI Trading Coach & Indian Market Academy ──────────────────────────────────
# Options:
#   local-rag  (default, zero external API cost, works on any CPU)
#   ollama     (connects to your custom QLoRA fine-tuned model via Ollama — see ai-coach-training/)
#   gemini     (optional cloud LLM; requires GEMINI_API_KEY)
AI_COACH_PROVIDER=local-rag
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=blocktrade-coach
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
