# Optional: Backend API origin when deploying frontend separately on Vercel
# Example: https://your-backend-host.onrender.com
# Leave empty for local development (uses Vite /api proxy to http://localhost:5100)
VITE_API_BASE_URL=

# Optional: Explicit WebSocket URL override (defaults to wss://<VITE_API_BASE_URL host>/ws/market)
# Example: wss://your-backend-host.onrender.com/ws/market
VITE_WS_URL=
